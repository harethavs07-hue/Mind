rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helpers
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             data.memoryEnabled is bool &&
             data.faceConsentGranted is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMemory(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.category in ['GOAL', 'PREFERENCE', 'IDEA', 'DECISION', 'PATTERN', 'PROBLEM', 'OUTCOME'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
             data.approved is bool &&
             data.source in ['USER', 'SHADOW_PROPOSED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.role in ['USER', 'SHADOW'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 8000 &&
             data.reasoningMode in ['GREETING', 'UNDERSTAND', 'CHALLENGE', 'QUESTION', 'BLIND_SPOT', 'CREATIVE_SYNTHESIS'] &&
             data.clientOrder is int && data.clientOrder >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 1. User Profile & Consent Preferences
    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'memoryEnabled', 'faceConsentGranted', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'memoryEnabled', 'faceConsentGranted', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'memoryEnabled', 'faceConsentGranted', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // 2. Persistent Cognitive Memories Subcollection
      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(memoryId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'category', 'title', 'content', 'approved', 'source', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'category', 'title', 'content', 'approved', 'source', 'createdAt', 'updatedAt']) &&
                         isValidMemory(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(memoryId) &&
                         isValidMemory(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().source == existing().source &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['category', 'title', 'content', 'approved', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(memoryId);
      }

      // 3. Continuous Shadow Room Messages Subcollection
      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(messageId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'role', 'text', 'reasoningMode', 'clientOrder', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'role', 'text', 'reasoningMode', 'clientOrder', 'createdAt', 'updatedAt']) &&
                         isValidMessage(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().role == existing().role &&
                         incoming().clientOrder == existing().clientOrder &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'reasoningMode', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(messageId);
      }
    }
  }
}
